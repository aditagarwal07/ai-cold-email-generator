# Copy to .streamlit/secrets.toml locally; never commit the real file.
# On Community Cloud, paste settings into the app's Secrets configuration.
GROQ_API_KEY = "REPLACE_WITH_YOUR_GROQ_KEY"
GROQ_MODEL = "llama-3.3-70b-versatile"
# The UI defaults to Groq. Gemini is optional unless you select it.
GEMINI_API_KEY = "REPLACE_WITH_YOUR_KEY"
GEMINI_MODEL = "gemini-flash-latest"
# Optional: gemini-flash-lite-latest is documented in Google's Models cookbook.
# Verify access/JSON support for your account first. Blank disables selection.
GEMINI_FALLBACK_MODEL = ""
# Enable only temporarily in a controlled/private deployment; this is not authentication.
ENABLE_GEMINI_DIAGNOSTICS = false
# Delivery is disabled in this MVP. Do not configure a webhook yet.
